<?php

namespace Drupal\Core\Field;

use Drupal\Core\Form\FormStateInterface;

abstract class WidgetBase extends PluginSettingsBase implements WidgetInterface, ContainerFactoryPluginInterface {

  /**
   * @param array<array-key,mixed> $plugin_definition
   * @param array<array-key,mixed> $settings
   * @param array<array-key,mixed> $third_party_settings
   *
   * @return array<array-key,mixed>
   */
  public function __construct(string $plugin_id, mixed $plugin_definition, FieldDefinitionInterface $field_definition, array $settings, array $third_party_settings) {}

  /**
   * @param int $delta
   * @param array<array-key,mixed> $element
   * @param array<array-key,mixed> $form
   *
   * @return array<array-key, mixed>
 */
  protected function formSingleElement(FieldItemListInterface $items, $delta, array $element, array &$form, FormStateInterface $form_state) {}
}
