<?php

namespace Drupal\Core\Field;

interface WidgetInterface extends WidgetBaseInterface {

  /**
   * @param ArrayMixed $form
   *
   * @return ArrayMixed
   */
  public function settingsForm(array $form, FormStateInterface $form_state): array;

  /**
   * @return ArrayMixed
   */
  public function settingsSummary();

  /**
   * @param \Drupal\Core\Field\FieldItemList<\Drupal\Core\Field\FieldItemInterface> $items
   * @param ArrayMixed $element
   * @param int $delta
   * @param ArrayMixed $form
   *
   * @return ArrayMixed
   */
  public function formElement(FieldItemListInterface $items, int $delta, array $element, array &$form, FormStateInterface $form_state);

  /**
   * @param ArrayMixed $element
   * @param ArrayMixed $form
   *
   * @return ArrayMixed|bool
   */
  public function errorElement(array $element, ConstraintViolationInterface $violation, array $form, FormStateInterface $form_state);

  /**
   * @param ArrayMixed $values
   * @param ArrayMixed $form
   *
   * @return ArrayMixed
   *   An array of field values, keyed by delta.
   */
  public function massageFormValues(array $values, array $form, FormStateInterface $form_state);

}
