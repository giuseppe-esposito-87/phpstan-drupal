<?php

namespace Drupal\Core\Field;

/**
 * @template T of FieldItemListInterface
 */
interface FormatterInterface extends PluginSettingsInterface {

  /**
   * @param array<T> $entities_items
   */
  public function prepareView(array $entities_items): void;

  /**
   * @param \Drupal\Core\Field\FieldItemList<mixed> $items
   * @param string|null $langcode
   *
   * @return array<int|string, mixed>
   */
  public function view(FieldItemListInterface $items, string $langcode = NULL): array;

  /**
   * @param \Drupal\Core\Field\FieldItemList<mixed> $items
   * @param string $langcode
   *
   * @return array<int, array<int|string, mixed>>
   */
  public function viewElements(FieldItemListInterface $items, string $langcode);

}
