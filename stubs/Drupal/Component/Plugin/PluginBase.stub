<?php

namespace Drupal\Component\Plugin;

abstract class PluginBase implements PluginInspectionInterface, DerivativeInspectionInterface {

  /**
   * @param ArrayMixed $configuration
   *   A configuration array containing information about the plugin instance.
   * @param string $plugin_id
   *   The plugin ID for the plugin instance.
   * @param mixed $plugin_definition
   *   The plugin implementation definition.
   */
  public function __construct(array $configuration, string $plugin_id, mixed $plugin_definition) {}

}
